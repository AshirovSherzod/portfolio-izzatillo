# Formalar xabarni `api/send.ts` serverless funksiyasi orqali Telegram'ga
# yuboradi. Token faqat shu funksiya ichida o'qiladi — brauzerga tushmaydi.
#
# DIQQAT: nomlarga `VITE_` prefiksini QO'SHMANG. Prefiks qo'shilsa, Vite
# qiymatni brauzer bundle'iga yozib qo'yadi va token yana ochilib qoladi.

# @BotFather -> /newbot -> token
TELEGRAM_BOT_TOKEN=

# Xabar tushadigan chat id. @userinfobot ga yozsangiz o'z id'ingizni beradi.
TELEGRAM_CHAT_ID=
