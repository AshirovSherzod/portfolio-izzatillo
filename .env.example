# Contact formasi xabarlarni shu bot orqali Telegram'ga yuboradi.
# Nusxa oling: cp .env.example .env
#
# DIQQAT: VITE_ bilan boshlanadigan o'zgaruvchilar brauzerga tushadigan
# bundle ichiga kiradi — token maxfiy emas. Faqat shu sayt uchun ochilgan,
# boshqa hech qayerda ishlatilmaydigan bot tokenini qo'ying.

# @BotFather -> /newbot -> token
VITE_TELEGRAM_BOT_TOKEN=

# Xabar tushadigan chat id. @userinfobot ga yozsangiz o'z id'ingizni beradi.
VITE_TELEGRAM_CHAT_ID=
